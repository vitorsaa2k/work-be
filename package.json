{
  "name": "work-be",
  "version": "0.1.0",
  "private": true,
  "description": "Backend foundation for Work, a local small-gig marketplace",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "predev": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "prebuild": "prisma generate",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "pretest": "prisma generate",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "pretest:unit": "prisma generate",
    "test:integration": "vitest run tests/integration",
    "pretest:integration": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "predb:seed": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.9",
    "hono": "^4.13.14",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
